# ==========================================
# AI Study Buddy - Environment Configuration
# ==========================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env (or copy .env.example .env in Windows)
# 2. Get a free Google Gemini API key from:
#    https://aistudio.google.com/app/apikey
# 3. Paste your key below:

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Server Port (default 5000)
PORT=5000
